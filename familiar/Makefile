# familiar-bg build. The successor body: same proven wayland/EGL/GLES3 harness as orb-bg, a far
# more detailed raymarched creature shader. Protocol client code is generated by wayland-scanner:
#   - xdg-shell from the installed wayland-protocols (the layer-shell XML imports xdg_popup)
#   - wlr-layer-shell from the XML vendored in protocol/ (not shipped by wayland-protocols)
PKGS      = wayland-client wayland-egl egl glesv2
BUILD     = build
CFLAGS   += -O2 -Wall -Wextra -std=c11 $(shell pkg-config --cflags $(PKGS)) -I$(BUILD)
LDLIBS    = $(shell pkg-config --libs $(PKGS)) -lm -lpthread
WPD       = $(shell pkg-config --variable=pkgdatadir wayland-protocols)
XDG_XML   = $(WPD)/stable/xdg-shell/xdg-shell.xml
WLR_XML   = protocol/wlr-layer-shell-unstable-v1.xml
PREFIX   ?= $(HOME)/.local

PROTO_SRC = $(BUILD)/xdg-shell-protocol.c $(BUILD)/wlr-layer-shell-unstable-v1-protocol.c
PROTO_HDR = $(BUILD)/xdg-shell-client-protocol.h $(BUILD)/wlr-layer-shell-unstable-v1-client-protocol.h

all: $(BUILD)/familiar-bg

bench: $(BUILD)/familiar-bench

# genotype.h is a REAL dependency, not documentation. Without it here, editing the shared
# gene table left the bench linked against the old one: `make bench` said "Nothing to be done",
# the new genes were rejected as unknown names, and the render came back identical - which
# reads exactly like "the feature does nothing" rather than "the binary is stale".
$(BUILD)/familiar-bench: bench.c genotype.h | $(BUILD)
	cc $(CFLAGS) -o $@ bench.c $(LDLIBS)

$(BUILD)/familiar-bg: main.c genotype.h $(PROTO_SRC) $(PROTO_HDR)
	cc $(CFLAGS) -o $@ main.c $(PROTO_SRC) $(LDLIBS)

$(BUILD)/xdg-shell-client-protocol.h: $(XDG_XML) | $(BUILD)
	wayland-scanner client-header $< $@
$(BUILD)/xdg-shell-protocol.c: $(XDG_XML) | $(BUILD)
	wayland-scanner private-code $< $@
$(BUILD)/wlr-layer-shell-unstable-v1-client-protocol.h: $(WLR_XML) | $(BUILD)
	wayland-scanner client-header $< $@
$(BUILD)/wlr-layer-shell-unstable-v1-protocol.c: $(WLR_XML) | $(BUILD)
	wayland-scanner private-code $< $@

$(BUILD):
	mkdir -p $(BUILD)

# The severance + layer-hygiene checks. `install` depends on this on purpose: a build that would put
# something large of ours above the bar (and over lan-mouse's edge-capture strip) must not be
# installable. It has cost the KVM bridge twice.
check:
	./check.sh

install: all check
	install -Dm755 $(BUILD)/familiar-bg $(PREFIX)/bin/familiar-bg
	install -Dm755 fire-gesture.sh $(PREFIX)/bin/fire-gesture
	install -Dm755 use-realm.sh $(PREFIX)/bin/use-realm
	install -Dm755 familiar-drawer.sh $(PREFIX)/bin/familiar-drawer
	install -Dm644 familiar.frag $(HOME)/.config/familiar/familiar.frag

clean:
	rm -rf $(BUILD)

.PHONY: all bench check install clean