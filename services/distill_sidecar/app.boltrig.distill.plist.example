<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.boltrig.distill</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/CHANGEME/Projects/boltrig/services/distill_sidecar/app.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BOLTRIG_DISTILL_MLX_PYTHON</key>
    <string>/Users/CHANGEME/opbox-dev/mlx-venv/bin/python</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
