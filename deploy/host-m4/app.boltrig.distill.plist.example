<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install: sed 's|CHANGEME|'"$USER"'|g' > ~/Library/LaunchAgents/app.boltrig.distill.plist
  then `launchctl load` it. See README.md beside this file.

  launchd does NOT expand ~ or $HOME, so every path here is absolute. It runs
  the wrapper rather than app.py directly, because the sidecar must be started
  by the MLX venv's interpreter (Metal), not the system python.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.boltrig.distill</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/CHANGEME/Projects/boltrig/deploy/host-m4/run-distill-sidecar.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/boltrig-distill-sidecar.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/boltrig-distill-sidecar.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/CHANGEME/Projects/boltrig</string>
</dict>
</plist>
