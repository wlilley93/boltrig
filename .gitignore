# --- secrets / local config (NEVER commit) ---
.env
.env.*
!.env.example
manifest.yaml
deploy/ca-bundle.crt
deploy/rclone/
**/rclone.conf
.models/

# --- agent working directories ---
.claude/
.skillops/
# ANCHORED, and it is the scratch root for smoke runs -- mktemp dirs like
# work/codex-x64-smoke.6n4iHx/ plus captured screenshots. Nothing under it has
# ever been tracked, and it reached 637 MB (two extracted codex binaries at
# 291 MB and 253 MB) while invisible to `git status` summaries. A `git add -A`
# would have committed all of it. Regenerable output, so it is ignored rather
# than curated.
/work/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
# ANCHORED. Unanchored `build/` matches a directory of that name ANYWHERE,
# and it silently swallowed apps/worker/src/components/build/ - eight real
# source components that CI could not find because they were never committed.
# This rule is about setuptools output at the repository root, so it says so.
/build/
dist/
.eggs/
# Both forms, deliberately. A trailing slash matches a DIRECTORY only, and
# that is how a self-referential `.venv` SYMLINK reached main in #177: it was
# not a directory, so `.venv/` never ignored it and `git add -A` took it.
.venv
.venv/
venv/
.python-version

# --- test / tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
site/coverage/

# --- node / frontend ---
node_modules/
apps/worker/dist/
apps/worker/node_modules/
# sdks/web installs its deps as a SYMLINK, and `node_modules/` (trailing slash)
# only matches real directories - so the symlink needs its own entry.
sdks/web/node_modules
*.tsbuildinfo

# --- editors / os ---
.idea/
.vscode/
*.swp
.DS_Store

# Local per-box compose override (desktop orb phenotype handoff etc.) - never committed.
docker-compose.override.yml
backups/
.secrets/
deploy/wheelhouse/
docker-compose.override.*.yml*
_migration/

# pnpm content-addressable cache. Never source; it was committed by
# accident in e7f56dfc and carries third-party fixture keys.
.pnpm-store/
