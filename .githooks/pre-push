#!/usr/bin/env bash
# boltrig pre-push gate.
#
# WHY THIS DID NOT EXIST UNTIL 2026-08-02. boltrig is the one repo in the estate with genuinely live
# CI - it is public, so Actions minutes are free, and its runs take 4-9 minutes and go green. The
# other three repos have a local pre-push gate and dead-or-manual CI. The cross-repo mechanism
# register put it as: "the three repos with a pre-push gate have dead-or-manual CI; the repo with
# live CI has no pre-push gate. Neither mechanism was carried across." This is that half closed.
#
# It is NOT redundant with CI. CI tells you after the push, from a machine, once the branch is
# already public; this refuses the push. And CI is only free while the repo stays public.
#
# WHAT IT RUNS, and why not `make check`. `make check`'s own help text says "Run the local Python
# gates CI enforces". Measured 2026-08-02, that is FALSE: CI runs `make python-quality`, and `check`
# omits SEVEN of its targets - claims, commit-trailers, gate-coverage, health-claims,
# order-directives, override-locks, prose-references. Among them is `gate-coverage`, which is
# boltrig's OWN CI-reachability census: the mechanism this repo owns and the others lack was one of
# the things you skipped by running the target documented as the CI-equivalent one. Fixed in the
# Makefile in the same commit; this hook runs `python-quality` so it cannot drift from CI again by
# someone editing a second list.
#
# Plus the two targets `check` has that `python-quality` does not and CI does not run either -
# codex-pin-health (2s) and continuity-projection (0s). They are free and they guard a pin and an
# allowlist that have both moved unexpectedly before.
#
# Measured cost: python-quality 324s (3615 tests, 86.89% coverage), the other two ~2s.
#
# WHAT IT DOES NOT RUN, and why the old label was dangerous. Until 2026-08-14 the line below
# announced `python-quality (the target CI runs)`. Singular "the". CI runs EIGHT jobs; this runs
# one of them, and one of the four steps inside that one. PR #266 pushed on a green print from
# this hook and arrived with eight red checks. A hook that is trusted and wrong is worse than no
# hook, so the label now names its own scope and the footer prints the uncovered jobs.
#
# And a bigger hook would NOT have caught that push. Measured, per failure:
#
#   worker-build       merge conflict with main. `make worker-quality` on the branch TIP passes;
#                      the failing test file existed only on main. Different COMMIT.
#   test-and-gate      ten tests read the gitignored manifest.yaml. This hook already runs that
#                      exact target and it passed - the VM mounts the host tree, so an untracked
#                      file participated. Different FILESYSTEM.
#   compose-validate   `PY ?= .venv/bin/python` here, `PY=python` on a runner with no install.
#                      The venv had the package. Different INTERPRETER.
#   desktop windows    a POSIX path literal in a Rust fixture. No machine here runs windows-2025.
#                      Different PLATFORM.
#
# Four failures, four axes, none of them "a missing make target". Adding every CI target to this
# hook and changing nothing else still prints green on that same push. The axes are what to fix -
# see docs/CI-RED-2026-08-14.md - and until they are, this hook is a fast first filter and NOT a
# prediction of CI.
#
# Skips, each deliberate and each leaving a trace in the command you typed:
#   SKIP_PUSH_GATES=1     everything
#   SKIP_QUALITY_GATE=1   just the slow python-quality run
# Emergency: git push --no-verify.
#
# Install: git config core.hooksPath .githooks   (RELATIVE - see below)

set -uo pipefail

if [[ "${SKIP_PUSH_GATES:-}" == "1" ]]; then
  echo "[pre-push] SKIP_PUSH_GATES=1 set — skipping all gates."
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

# A RELATIVE core.hooksPath is resolved by git against the top of each WORKING TREE, so a worktree
# runs its own branch's hooks. An ABSOLUTE one makes every linked worktree execute whatever is
# checked out in one directory - which on 2026-08-02 meant 45 worktrees across opbox-frontend and
# opbox-prod running a hook 732 commits stale, while the corrected version on main never executed
# once. Refuse to run under the absolute form rather than become that.
hooks_path="$(git config --get core.hooksPath || true)"
case "$hooks_path" in
  /*)
    echo "[pre-push] core.hooksPath is ABSOLUTE ($hooks_path) — push blocked."
    echo "[pre-push]   Every linked worktree would run THAT tree's hooks, whatever branch it pushes."
    echo "[pre-push]   Fix: git config core.hooksPath .githooks"
    exit 1
    ;;
esac

run_gate() { # run_gate "<name>" <make target>
  local name="$1" target="$2" start
  printf '\n[pre-push] === %s ===\n' "$name"
  start=$(date +%s)
  if ! make "$target"; then
    echo ""
    echo "  $name FAILED — push blocked."
    echo "  Fix it, or in a real hurry: git push --no-verify"
    exit 1
  fi
  echo "[pre-push] ✓ $name ($(( $(date +%s) - start ))s)"
}

run_gate "codex pin health" codex-pin-health
run_gate "continuity projection" continuity-projection

# CI checks out refs/pull/N/merge - main merged INTO the branch - and this hook checks out the
# branch tip. When main has moved, those are different trees, and a change that is correct on
# each side alone can fail only on the merge. That is exactly how PR #266's worker-build broke:
# main added a test pinning a path this branch had moved. Nothing local can see it while the two
# are unmerged, so say so before the push rather than after the red.
#
# A warning, not a block. Blocking would refuse every push from a branch that main has merely
# moved past, including the ones that are fine, and several sessions share this tree. Promoting
# it to a block is an operator call, not this hook's.
if ! git merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
  behind="$(git rev-list --count HEAD..origin/main 2>/dev/null || echo '?')"
  echo ""
  echo "[pre-push] NOTE: origin/main is $behind commit(s) ahead and NOT merged into this branch."
  echo "[pre-push]   CI tests refs/pull/N/merge. These gates test the branch tip. Different trees."
  echo "[pre-push]   A semantic merge conflict is invisible here and red there. Merge origin/main"
  echo "[pre-push]   and re-run if CI matters to you more than this print does."
fi

if [[ "${SKIP_QUALITY_GATE:-}" == "1" ]]; then
  echo "[pre-push] SKIP_QUALITY_GATE=1 set — skipping python-quality (one of CI's eight jobs)."
else
  # `quality-gate`, not `python-quality` directly. On Linux the two are identical -
  # it execs the same target. On macOS it runs that target inside a Linux VM,
  # because on the host it CANNOT pass: 17 of these tests assert Linux kernel
  # controls (yama ptrace_scope, SO_PEERCRED, landlock/seccomp) that macOS does not
  # implement. Measured on the M4: 34 failures on the host, 1 in the VM.
  #
  # This is not the "second list" this file's own preamble warns about. It is one
  # line of dispatch around the SAME make target CI runs, so there is still nothing
  # to drift.
  run_gate "python-quality (1 of CI's 8 jobs, 1 of its 4 steps)" quality-gate
fi

# "all gates green" was the other half of the false promise: it is true of the gates this hook
# runs and reads as true of CI. Name what was not looked at. A written gap is arguable; a silent
# one is what let PR #266 push on a green print.
echo ""
echo "[pre-push] the gates ABOVE are green. NOT run here, and NOT predicted by this:"
echo "[pre-push]   worker-build            make worker-quality"
echo "[pre-push]   worker-desktop-package  cargo test + tauri build, x3 incl. windows-2025"
echo "[pre-push]   site-build-test-lint    make site-quality"
echo "[pre-push]   compose-validate        make compose-validate PY=python   (bare, no venv)"
echo "[pre-push]   source-security         python-audit, sast, iac-scan, secret-scan, actionlint"
echo "[pre-push]   codeql / containers     GitHub-hosted; unreachable from any local gate"
echo "[pre-push]   and, in test-and-gate:  public-product-validate, migration-parity, doctor-fixture"
exit 0
