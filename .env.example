# Boltrig process environment (SRS S11). Copy to .env and fill in.
#
#   cp .env.example .env
#
# Process wiring (where the DB is, which secret store, the egress proxy) lives
# here; per-tenant POLICY lives in the fleet manifest (manifest.yaml). The same
# image runs every tenant: only this file and the manifest differ (P7).
#
# NEVER commit a real .env. Secrets belong in your secret store, not in git.
# The values referenced here are read by boltrig/config/settings.py and by the
# credential resolver (boltrig/kernel/credentials.py, EnvSecretStore).

# --- datastores -------------------------------------------------------------
# asyncpg driver for the kernel; host "postgres" is the compose service name.
# M9 (SEC-69): the password segment MUST match POSTGRES_PASSWORD below. There is
# no baked default any more - replace CHANGE_ME here and set POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://boltrig:CHANGE_ME@postgres:5432/boltrig
REDIS_URL=redis://redis:6379/0

# Postgres bootstrap (consumed by the postgres service in docker-compose.yml).
# M9 (SEC-69): REQUIRED. docker-compose refuses to start unless POSTGRES_PASSWORD
# is set - there is deliberately NO default in the committed compose. Generate a
# strong value and keep it out of git:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=boltrig
POSTGRES_PASSWORD=
POSTGRES_DB=boltrig

# --- audit (tamper-evident hash chain, SEC-16/K-19) -------------------------
# Per-deployment HMAC key for the audit chain. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BOLTRIG_AUDIT_HMAC_KEY=change-me-to-a-long-random-secret

# --- secret store (SEC-04: the DB holds references only, never plaintext) ----
# One of: env | vault | kms | docker. "env" reads credential material from the
# per-adapter env vars below; each value is a JSON object.
SECRET_STORE=env

# --- identity / OIDC (SEC-01/02; production MUST verify tokens) --------------
# When the OIDC trio is set the kernel verifies real bearer tokens
# (boltrig/identity/auth.py OidcVerifier). With no OIDC config the kernel refuses
# all requests (fail-closed) UNLESS BOLTRIG_DEV_AUTH=1, which enables the
# header-trusting dev resolver. NEVER set BOLTRIG_DEV_AUTH=1 in production.
OIDC_ISSUER=https://login.example.com/
OIDC_AUDIENCE=boltrig
OIDC_JWKS_URI=https://login.example.com/.well-known/jwks.json
# BOLTRIG_DEV_AUTH=1   # local dev only: trust x-boltrig-* headers (no verification)

# --- Cloudflare Access (zero-trust edge IdP; takes precedence over OIDC) ------
# When the team domain + AUD are set, the kernel verifies the per-request
# Cf-Access-Jwt-Assertion against CF's JWKS and derives the principal from the
# authenticated email. Login / MFA / SSO happen at the Cloudflare edge; the
# kernel trusts only the verified assertion. CF_ACCESS_ROLE_MAP maps each allowed
# email to a platform role; an authenticated-but-unmapped email is denied
# (CF_ACCESS_DEFAULT_ROLE=none = fail-closed). Put app.boltrig.io behind a CF
# Access application, then set:
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<the Access application AUD tag>
# CF_ACCESS_ROLE_MAP={"you@example.com":"org-admin"}
# CF_ACCESS_DEFAULT_ROLE=none
# CF_ACCESS_TENANT=default

# The service-principal the agents act as for non-delegated calls (US-IAM-03).
AGENT_SP_ID=boltrig-agent

# --- notifications / HITL channel -------------------------------------------
# Microsoft Teams (or Slack) incoming webhook for approval routing (Epic K).
TEAMS_WEBHOOK=https://outlook.office.com/webhook/REPLACE

# --- inference back ends (P4; none are required by the core) -----------------
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- network posture (US-DEP-04, SEC) ---------------------------------------
# Corporate egress proxy (also pass as --build-arg to the Dockerfiles).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,redis,kernel,pi-sidecar,rivet-agentos,hatchet-engine,bifrost,local-model,langfuse
# Path to a custom CA bundle inside the container (mount it in if needed).
CA_BUNDLE=
# Set true to forbid all outbound network and force on-box inference (SEC-12).
AIR_GAPPED=false

# --- compose port overrides (optional) --------------------------------------
KERNEL_PORT=8000
UI_PORT=8080
HATCHET_GRPC_PORT=7077
HATCHET_API_PORT=8888
HATCHET_DASHBOARD_PORT=8889
LOCAL_MODEL_PORT=8001
# LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- M10 (SEC-70): scheduled off-box backup ---------------------------------
# Consumed by the profile-gated `backup` sidecar (docker compose --profile backup
# up -d), which loops scripts/backup.sh. Off-box copy + encryption are OPTIONAL:
# with BACKUP_REMOTE unset the sidecar still dumps locally and warns that the
# off-box leg was skipped (safe for dev). See docs/backup-restore.md.
# How often to run a backup, in seconds (default 24h).
BACKUP_INTERVAL=86400
# How many local dumps to keep (older ones are pruned).
BACKUP_KEEP=7
# Where the dumps land on the host (bind-mounted into the sidecar as /backups).
BACKUP_DIR=./backups
# Off-box destination as an rclone remote path (e.g. "s3:my-bucket/boltrig" or
# "b2:bucket/path"). UNSET => off-box copy is skipped with a warning (dev). SET =>
# a run fails loudly if the copy fails, so a broken remote cannot pass silently.
# BACKUP_REMOTE=s3:my-bucket/boltrig
# Directory holding your configured rclone.conf (mounted read-only). Only needed
# when BACKUP_REMOTE is set.
# RCLONE_CONFIG_DIR=./deploy/rclone
# Optional symmetric passphrase - when set, each dump is encrypted at rest with
# openssl AES-256 before it is written / copied off-box. Keep it in your secret
# store; without it a restore is impossible.
# BACKUP_PASSPHRASE=

# --- per-adapter credentials (refs resolved by EnvSecretStore as JSON) ------
# Each variable name is the credential ref named in manifest.yaml. The value is
# a JSON object of secret material handed to ONE adapter call inside the kernel
# and never returned to an agent or written to the audit log (SEC-05, K-20).
# MS Graph application credentials (ms-graph adapter).
GRAPH_APP={"tenant_id":"","client_id":"","client_secret":""}
# Jira OAuth / API token (jira adapter).
JIRA_OAUTH={"base_url":"https://your-org.atlassian.net","email":"","api_token":""}
# CRM SQL connection (crm-sql adapter).
CRM_SQL={"dsn":"postgresql://user:pass@crm-db:5432/crm"}

# --- Boltrig v2 selected stack ------------------------------------------------
# Rivet AgentOS runtime/sandbox. Unset URL -> rivet-worker degrades safely.
# RIVET_AGENTOS_URL=http://rivet-agentos:2468
# RIVET_AGENTOS_TOKEN=
# RIVET_AGENTOS_RUN_PATH=/runs
# BOLTRIG_RIVET_MCP_URL=http://kernel:8000/v1/mcp
# Browser Use CLI automation. The adapter shells out to `browser-use`; keep its
# auth/session/cache under stack-owned state rather than a developer profile.
# BOLTRIG_BROWSER_CLI_HOME=/var/lib/boltrig/browser-cli
# BOLTRIG_BROWSER_CLI_BIN=/usr/local/bin/browser-use
# BOLTRIG_BROWSER_ALLOWED_DOMAINS=
# Browser Use cloud profile handoff is disabled by default. Set policy=stack to
# pass only these BOLTRIG_* values into the child process as Browser Use env.
# Never set personal BROWSER_USE_* variables in the service environment.
# BOLTRIG_BROWSER_CLOUD_POLICY=disabled
# BOLTRIG_BROWSER_CLOUD_API_KEY=
# BOLTRIG_BROWSER_CLOUD_PROFILE_ID=
# BOLTRIG_BROWSER_CLOUD_PROJECT_ID=
# BOLTRIG_BROWSER_CLOUD_TEAM_ID=
# Stack-owned Herdr/OpenCode state. Compose defaults these to named volumes, but
# production doctor expects explicit values in non-compose or checked env files.
# Do not point them at a developer user's ~/.config, ~/.local, or .opencode state.
# BOLTRIG_HERDR_HOME=/var/lib/boltrig/herdr
# BOLTRIG_OPENCODE_HOME=/var/lib/boltrig/opencode
# Mem0 primary operational memory projection.
# MEM0_API_KEY=
# MEM0_ORG_ID=
# MEM0_PROJECT_ID=
# Langfuse observability sink.
# BOLTRIG_LANGFUSE_ENABLED=true
# LANGFUSE_HOST=http://langfuse:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- Round Two compatibility: Pi sidecar + MCP wiring (Epic RUN / MCP) -------
# Where the fleet reaches the Pi sidecar, and the kernel MCP URL the sidecar uses
# (manifest runtimes.pi maps to these). Unset BOLTRIG_PI_SIDECAR_URL -> pi
# capabilities degrade offline (P9).
BOLTRIG_PI_SIDECAR_URL=http://pi-sidecar:8090
BOLTRIG_PI_MCP_URL=http://kernel:8000/v1/mcp
BOLTRIG_PI_MAX_STEPS=12
# Shared secret for the sidecar /run endpoint (M2/SEC-73). Set the SAME value
# here (loaded by the fleet-worker) and it is passed to the pi-sidecar service;
# the worker's PiRuntime presents it as a bearer. Unset = dev-open, but the
# sidecar fails closed under a production signal. Generate a strong value in prod.
PI_SIDECAR_TOKEN=
# Optional comma-separated egress allow-list for the sidecar's mcp/model hosts
# (metadata/loopback/link-local are never allow-listable).
PI_SIDECAR_EGRESS_ALLOW=kernel,bifrost,local-model

# --- Round Six: conversation continuity + model gateway (pi lane) -----------
# Continuity composes prior turns into the prompt (gap 3.1). On by default; set
# to 0 to restore the prior single-message behaviour exactly.
BOLTRIG_CONTINUITY=1
# Model gateway (gap 3.2): when set, standard conversation traffic routes through
# the gateway, pinned to one model per conversation for cache warmth (SEC-47).
# Sensitive data is never routed here (residency). Unset => the seam is inert.
# To activate: `docker compose --profile gateway up -d` (starts the bifrost
# service), configure provider keys in the Bifrost UI at http://localhost:8081,
# then uncomment the line below. Bifrost is OpenAI-compatible inside compose on
# :8080; Pi appends /chat/completions, so the gateway URL includes /v1.
# BOLTRIG_MODEL_GATEWAY_URL=http://bifrost:8080/v1
BOLTRIG_MODEL_GATEWAY_TTL=900
# Optional live gateway health for /v1/platform/status. Disabled by default; when
# enabled, Boltrig derives http://bifrost:8080/health from the /v1 URL unless an
# explicit internal health URL/path is set. External hosts are not polled.
# BOLTRIG_MODEL_GATEWAY_HEALTH=0
# BOLTRIG_MODEL_GATEWAY_HEALTH_PATH=/health
# BOLTRIG_MODEL_GATEWAY_HEALTH_URL=
# BOLTRIG_MODEL_GATEWAY_HEALTH_TIMEOUT=0.75
# BIFROST_PORT=8081

# --- Deep readiness ---------------------------------------------------------
# /readyz always verifies control-plane registration and stack-tool posture. In
# production it also requires DATABASE_URL + REDIS_URL and the exact Alembic
# head. Production additionally runs Herdr in the kernel and requires a fresh
# HMAC-authenticated Redis receipt from fleet-local OpenCode, Browser Use, and
# Chromium probes; the kernel never assumes those fleet-owned binaries share its
# container. Receipt authentication derives a purpose-separated key from the
# deployment's BOLTRIG_AUDIT_HMAC_KEY. Each readiness probe is bounded by this
# timeout (clamped to 0.05..10s).
BOLTRIG_READINESS_TIMEOUT=0.75
# Coalesce concurrent unauthenticated probes and cache only the redacted result
# briefly, preventing orchestrator/hostile polling from amplifying subprocesses.
# BOLTRIG_READINESS_CACHE_TTL=1
# Require live stack-tool evidence outside production too (default: posture-only
# compatibility in development). Fleet receipts expire and cannot survive a
# dead worker; interval and probe time are cross-bounded against TTL. All values
# are bounded.
# BOLTRIG_REQUIRE_STACK_TOOL_HEALTH=0
# BOLTRIG_STACK_TOOL_RECEIPT_TTL=30
# BOLTRIG_STACK_TOOL_HEARTBEAT_INTERVAL=10
# BOLTRIG_STACK_TOOL_PROBE_TIMEOUT=4
# Hatchet is probed only when explicitly enabled, durability is required, or a
# HATCHET_CLIENT_TOKEN is configured. A configured-but-unreachable engine makes
# /readyz fail closed instead of silently accepting the local executor.
# BOLTRIG_HATCHET_HEALTH=0
# BOLTRIG_REQUIRE_DURABLE=0

# --- Round Sixteen: edge/web hardening (WEB-*, RES-01) + prod guard (IAM-09) ----
# Host allowlist for the kernel app (TrustedHost). Default '*' (dev); a deployment
# SHOULD set its real hostnames.
# BOLTRIG_ALLOWED_HOSTS=api.example.com
# Browser CORS origin allowlist (never '*' with credentials). Default: same-origin.
# BOLTRIG_CORS_ORIGINS=https://app.example.com
# Request-body size cap in bytes (default 1 MiB).
# BOLTRIG_MAX_BODY_BYTES=1048576
# A production signal: with BOLTRIG_DEV_AUTH=1 set, the kernel REFUSES to start if
# any of ENV/BOLTRIG_ENV/APP_ENV is prod|production|staging or BOLTRIG_PRODUCTION=1.
# BOLTRIG_PRODUCTION=1
