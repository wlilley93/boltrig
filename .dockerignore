# Keep the build context small + secret-free.
.git
.gitignore
.venv
venv
# A bare pattern matches only the CONTEXT ROOT, so `__pycache__` alone let every
# nested one through: boltrig/store/__pycache__/tenant_scope.cpython-314.pyc was
# measured inside a python 3.12 image on 2026-07-31, host bytecode for the wrong
# interpreter shipped into the artefact. Needs the `**/` prefix to match at depth.
**/__pycache__
**/*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Never ship local secrets / config into an image.
.env
.env.*
manifest.yaml
.models
deploy/rclone/
**/rclone.conf

# Worker and site build contexts exclude their local dependencies and output.
apps/worker/node_modules
apps/worker/dist
apps/worker/node_modules
apps/worker/dist
apps/worker/src-tauri/target
node_modules

# Docs + tests are not needed at runtime.
docs
tests
*.md
# The Worker build imports the shared VDS token source. Re-allow only the
# three token files used by that build; the rest of the documentation remains
# outside image contexts.
!docs/
!docs/design/
!docs/design/imported/
!docs/design/imported/tokens/
!docs/design/imported/tokens/colors.css
!docs/design/imported/tokens/spacing.css
!docs/design/imported/tokens/typography.css
